@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Detailed debug information
message(STATUS "=== @PACKAGE_NAME@Config.cmake started ===")
message(STATUS "CMAKE_CURRENT_LIST_DIR: ${CMAKE_CURRENT_LIST_DIR}")
message(STATUS "CMAKE_PREFIX_PATH: ${CMAKE_PREFIX_PATH}")
message(STATUS "@PACKAGE_NAME@_FIND_COMPONENTS: ${@PACKAGE_NAME@_FIND_COMPONENTS}")
message(STATUS "@PACKAGE_NAME@_FIND_REQUIRED: ${@PACKAGE_NAME@_FIND_REQUIRED}")

# 获取支持的组件列表 - 从CMakeLists.txt传递过来的变量
set(SUPPORTED_COMPONENTS "@SUPPORTED_COMPONENTS@")
message(STATUS "Supported components: ${SUPPORTED_COMPONENTS}")

# Initialize variables
set(FOUND_COMPONENTS)
set(NOT_FOUND_COMPONENTS)

# Process all requested components directly, without complex comparisons
foreach(COMPONENT_NAME ${@PACKAGE_NAME@_FIND_COMPONENTS})
    message(STATUS "--- Processing component: ${COMPONENT_NAME} ---")
    
    # Directly check if component directory exists
    set(COMPONENT_DIR "${CMAKE_CURRENT_LIST_DIR}/${COMPONENT_NAME}")
    message(STATUS "Checking component directory: ${COMPONENT_DIR}")
    
    if(IS_DIRECTORY "${COMPONENT_DIR}")
        message(STATUS "✓ Component directory exists")
        
        # Check targets file
        set(TARGETS_FILE "${COMPONENT_DIR}/${COMPONENT_NAME}Targets.cmake")
        message(STATUS "Looking for targets file: ${TARGETS_FILE}")
        
        if(EXISTS "${TARGETS_FILE}")
            message(STATUS "✓ Targets file exists, including it")
            include("${TARGETS_FILE}")
            set(@PACKAGE_NAME@_${COMPONENT_NAME}_FOUND TRUE)
            list(APPEND FOUND_COMPONENTS ${COMPONENT_NAME})
            message(STATUS "✓ Successfully loaded targets for ${COMPONENT_NAME}")
        else()
            message(WARNING "✗ Targets file not found: ${TARGETS_FILE}")
            set(@PACKAGE_NAME@_${COMPONENT_NAME}_FOUND FALSE)
            list(APPEND NOT_FOUND_COMPONENTS ${COMPONENT_NAME})
        endif()
        
        # Check dependencies file
        set(DEPS_FILE "${COMPONENT_DIR}/${COMPONENT_NAME}Dependencies.cmake")
        message(STATUS "Looking for dependencies file: ${DEPS_FILE}")
        
        if(EXISTS "${DEPS_FILE}")
            message(STATUS "✓ Dependencies file exists")
            include("${DEPS_FILE}")
            
            # Process dependencies if defined
            if(DEFINED ${COMPONENT_NAME}_PUBLIC_DEPENDENCIES)
                message(STATUS "✓ Public dependencies defined: ${${COMPONENT_NAME}_PUBLIC_DEPENDENCIES}")
                
                foreach(_dep IN LISTS ${COMPONENT_NAME}_PUBLIC_DEPENDENCIES)
                    if(NOT _dep)
                        # Ignore empty list items (e.g. trailing ';')
                        continue()
                    endif()
                    string(REGEX REPLACE "::.*" "" _dep_namespace "${_dep}")
                    if(NOT _dep_namespace)
                        continue()
                    endif()
                    
                    # Skip internal dependencies
                    if(_dep_namespace STREQUAL "@PACKAGE_NAME@")
                        message(STATUS "Skipping internal dependency: ${_dep}")
                        continue()
                    endif()
                    
                    # Check if target already exists
                    if(NOT TARGET ${_dep})
                        message(STATUS "Looking for dependency: ${_dep_namespace}")
                        
                        # Method 1: First try relative path lookup
                        set(_dep_relative_path "../../../${_dep_namespace}")
                        set(_dep_config_candidate "${CMAKE_CURRENT_LIST_DIR}/${_dep_relative_path}/lib/cmake/${_dep_namespace}Config.cmake")
                        
                        message(STATUS "Looking for ${_dep_namespace} at: ${_dep_config_candidate}")
                        
                        if(EXISTS "${_dep_config_candidate}")
                            message(STATUS "✓ Found ${_dep_namespace}Config.cmake via relative path: ${_dep_config_candidate}")
                            
                            # 特殊处理MainRoutine依赖
                            if(_dep_namespace STREQUAL "MainRoutine")
                                set(MainRoutine_FIND_COMPONENTS "BaseRobot")
                                set(MainRoutine_FIND_REQUIRED TRUE)
                                message(STATUS "Setting MainRoutine_FIND_COMPONENTS: BaseRobot")
                            endif()
                            
                            include("${_dep_config_candidate}")
                        else()
                            message(STATUS "✗ Relative path not found for ${_dep_namespace}, trying standard lookup")
                            
                            # Method 2: If relative path fails, try standard lookup
                            if(_dep_namespace STREQUAL "MainRoutine")
                                find_dependency(${_dep_namespace} REQUIRED COMPONENTS BaseRobot)
                            else()
                                find_dependency(${_dep_namespace} REQUIRED)
                            endif()
                        endif()
                    else()
                        message(STATUS "✓ Dependency already available: ${_dep}")
                    endif()
                endforeach()
            endif()
        else()
            message(WARNING "✗ Dependencies file not found: ${DEPS_FILE}")
        endif()
    else()
        message(WARNING "✗ Component directory not found: ${COMPONENT_DIR}")
        set(@PACKAGE_NAME@_${COMPONENT_NAME}_FOUND FALSE)
        list(APPEND NOT_FOUND_COMPONENTS ${COMPONENT_NAME})
    endif()
endforeach()

# Set package status
message(STATUS "--- Summary ---")
message(STATUS "Found components: ${FOUND_COMPONENTS}")
message(STATUS "Not found components: ${NOT_FOUND_COMPONENTS}")

if(NOT_FOUND_COMPONENTS AND @PACKAGE_NAME@_FIND_REQUIRED)
    set(@PACKAGE_NAME@_FOUND FALSE)
    set(@PACKAGE_NAME@_NOT_FOUND_MESSAGE "Required components not found: ${NOT_FOUND_COMPONENTS}")
    message(STATUS "✗ Setting @PACKAGE_NAME@_FOUND to FALSE")
else()
    set(@PACKAGE_NAME@_FOUND TRUE)
    message(STATUS "✓ Setting @PACKAGE_NAME@_FOUND to TRUE")
endif()

# Set found status for each supported component
foreach(COMPONENT_NAME ${SUPPORTED_COMPONENTS})
    if(COMPONENT_NAME IN_LIST FOUND_COMPONENTS)
        set(@PACKAGE_NAME@_${COMPONENT_NAME}_FOUND TRUE)
        message(STATUS "✓ Component ${COMPONENT_NAME} marked as FOUND")
    else()
        set(@PACKAGE_NAME@_${COMPONENT_NAME}_FOUND FALSE)
        message(STATUS "✗ Component ${COMPONENT_NAME} marked as NOT FOUND")
    endif()
endforeach()

check_required_components(@PACKAGE_NAME@)

message(STATUS "=== @PACKAGE_NAME@Config.cmake finished ===")