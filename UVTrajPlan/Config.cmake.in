@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# ============================================================
# Load all component targets
# ============================================================

set(_@PACKAGE_NAME@_supported_components @SUPPORTED_COMPONENTS@)

# If user didn't request components, load all
if(NOT @PACKAGE_NAME@_FIND_COMPONENTS)
    set(@PACKAGE_NAME@_FIND_COMPONENTS ${_@PACKAGE_NAME@_supported_components})
endif()

foreach(_comp IN LISTS @PACKAGE_NAME@_FIND_COMPONENTS)

    list(FIND _@PACKAGE_NAME@_supported_components ${_comp} _index)
    if(_index EQUAL -1)
        set(@PACKAGE_NAME@_${_comp}_FOUND FALSE)
        if(@PACKAGE_NAME@_FIND_REQUIRED_${_comp})
            set(@PACKAGE_NAME@_FOUND FALSE)
            set(@PACKAGE_NAME@_NOT_FOUND_MESSAGE
                "Unsupported component: ${_comp}")
        endif()
        continue()
    endif()

    include("${CMAKE_CURRENT_LIST_DIR}/${_comp}/${_comp}Targets.cmake")

    # ============================================================
    # Component dependencies (GENERATED at configure time)
    # ============================================================
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/${_comp}/${_comp}Dependencies.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/${_comp}/${_comp}Dependencies.cmake")
    endif()

    set(@PACKAGE_NAME@_${_comp}_FOUND TRUE)
endforeach()

check_required_components(@PACKAGE_NAME@)
